{
  "name": "prepatlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:smoke",
    "test:unit": "node --experimental-strip-types --test tests/resource-policy.test.mjs tests/practice-artwork.test.mjs tests/practice-session.test.mjs tests/video-resources.test.mjs tests/feedback.test.mjs tests/calculus-bank.test.mjs tests/human-geography.test.mjs tests/geography-stimuli.test.mjs tests/topic-summaries.test.mjs",
    "feedback:admin": "node --experimental-strip-types scripts/feedback-admin.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:publication": "node --experimental-strip-types scripts/check-chemistry-publication.mjs && node --experimental-strip-types tests/chemistry-publication-smoke.mjs",
    "test:workspace": "node --experimental-strip-types tests/workspace-smoke.mjs",
    "test:preview": "node scripts/check-preview-stability.mjs",
    "test:calculus": "node --experimental-strip-types scripts/check-calculus-bank.mjs --write && node --experimental-strip-types scripts/check-calculus-math.mjs",
    "test:human-geography": "node --experimental-strip-types scripts/check-human-geography.mjs && node --experimental-strip-types tests/human-geography-smoke.mjs",
    "test:geography-bank": "node --experimental-strip-types scripts/check-human-geography-bank.mjs",
    "test:geography-complete": "node --experimental-strip-types scripts/check-human-geography-complete.mjs",
    "test:summaries": "node --experimental-strip-types scripts/check-topic-summaries.mjs --write"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
