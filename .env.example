# Copy to .env.local (ignored by Git). Leave blank until a real free project exists.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable client key; never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only origin; must match your browser, auth redirects and same-origin requests.
APP_ORIGIN=http://127.0.0.1:3000
# Keep false until age/privacy review AND Supabase provider settings are complete.
APP_REGISTRATION_ENABLED=false
# Optional SERVER ONLY secret key, needed only for confirmed account deletion.
# Never prefix this with NEXT_PUBLIC_, commit it, or paste it into chat.
SUPABASE_SECRET_KEY=
# Server-only random secret of at least 32 characters to sign short-lived recovery proofs.
AUTH_FLOW_SECRET=
